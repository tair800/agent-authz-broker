# Copy to .env for local work. Every value here is a placeholder. None of them is a credential,
# and .env itself is excluded by .gitignore.

# local | ci | staging | production. `production` stops the entrypoint seeding the demonstration.
# The accepted values are defined in src/agent_authz_broker/config.py.
AAB_ENVIRONMENT=local

# The database. `aab_local_dev` is the password in docker-compose.yml, on a container bound to
# 127.0.0.1 holding invented accounts and thrown away with `docker compose down`. It is not
# reachable from anywhere else and must never be reused for anything.
#
# Paste a provider's DSN verbatim, libpq query parameters and all. `async_dsn` in
# src/agent_authz_broker/db/engine.py selects the async driver and rewrites the query string
# into something asyncpg accepts. See docs/deployment.md.
AAB_POSTGRES_DSN=postgresql://aab:aab_local_dev@localhost:15434/aab

# **This server's own identity, and the whole of the audience check.** A token is refused unless
# its `aud` claim names exactly this string. Set it wrong and every call is denied with
# `audience_mismatch` — the server behaving correctly against a misconfiguration.
AAB_RESOURCE_SERVER_URL=http://localhost:8000/mcp

# Browser origins allowed to call the read-only console API, as a JSON array because
# pydantic-settings parses a complex field from JSON. Fail-closed: an empty list means no browser
# origin may call it directly.
#
# This has no bearing on authorization. CORS constrains browsers and constrains nothing that is not
# a browser; an attacker holding a token does not use one. See docs/threat-model.md.
AAB_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Gates the operator route that resets the demonstration database. Left commented out on purpose:
# unset means the route is unavailable, which is the right default everywhere that is not a public
# demonstration. It is never an MCP tool, so no agent can reach it whatever this is set to.
#
# On Render this is `sync: false` and is entered in the dashboard. A value must never be committed
# here — a CI job fails the build if one is.
# AAB_ADMIN_RESET_TOKEN=

# Gates the route a human uses to grant an approval. Left commented out for exactly the same
# reason as the reset above: unset disables the route, which is the correct default.
#
# **It is deliberately not an MCP credential and the test authority does not mint it.** An agent
# holding a perfectly valid, correctly attenuated token must not be able to approve its own
# irreversible action — this endpoint was open in every environment until a security review used
# it to produce one, and DECISIONS.md ADR-004 records how. The MCP surface cannot reach this route,
# but the agent is a process and makes ordinary HTTP requests to the same origin, so "not a tool"
# was never the boundary.
#
# On Render this is `sync: false` and is entered in the dashboard. Never commit a value.
# AAB_APPROVER_TOKEN=

# Most calls one verified subject may make to one tool per fixed 60-second window. 0 disables the
# ceiling entirely rather than refusing everything.
#
# It bounds an *authenticated* caller. It is **not DDoS protection**: volume that never presents a
# usable token is refused earlier, by the token verifier, and volume large enough to matter is a
# platform concern this application cannot address. See DECISIONS.md ADR-006.
AAB_RATE_LIMIT_PER_MINUTE=30
